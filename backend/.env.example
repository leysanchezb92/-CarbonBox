# Plantilla de configuración del backend.
# Copia este archivo como .env:  cp .env.example .env
# (el archivo .env no se sube a Git; este .env.example sí)

# Conexión a PostgreSQL. Debe coincidir con el usuario, la clave, la base y el puerto
# de docker-compose.yaml. Estas credenciales son solo para desarrollo local.
# Si cambias el puerto en docker-compose.yaml, cámbialo también aquí.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_processing?schema=public"

# ---- Opcionales: si no las defines, se usan estos valores por defecto ----
# Puerto de la API
# PORT=3001
# Dirección de la pantalla autorizada para llamar a la API (CORS)
# FRONTEND_ORIGIN=http://localhost:3000
# Carpeta de los archivos subidos y de la cola de mensajes (relativa a la carpeta backend)
# STORAGE_DIR=storage
# Tamaño máximo del CSV, en MB
# MAX_FILE_SIZE_MB=10
